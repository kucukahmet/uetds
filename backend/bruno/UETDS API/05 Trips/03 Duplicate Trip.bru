meta {
  name: 03 Duplicate Trip
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/trips/{{tripId}}/duplicate/
}

headers {
  Authorization: Bearer {{accessToken}}
  X-Company-ID: {{companyId}}
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("duplicateTripId", res.body.id);
  }
}
