meta {
  name: 01 Create Passenger
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/passengers/
  body: json
}

headers {
  Authorization: Bearer {{accessToken}}
  X-Company-ID: {{companyId}}
}

body:json {
  {
    "first_name": "Ayse",
    "last_name": "Demir",
    "identity_type": "tc",
    "identity_no": "22222222222",
    "nationality": "TR",
    "phone": "+905552222222"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("passengerId", res.body.id);
  }
}
