meta {
  name: 02 Save Test Credentials
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/uetds/credentials/
  body: json
}

headers {
  Authorization: Bearer {{accessToken}}
  X-Company-ID: {{companyId}}
}

body:json {
  {
    "environment": "test",
    "username": "{{uetdsUsername}}",
    "password": "{{uetdsPassword}}",
    "endpoint_url": "https://servis.turkiye.gov.tr/services/g2g/kdgm/test/uetdsarizi",
    "is_active": true
  }
}
