meta {
  name: 01 Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("accessToken", res.body.access_token);
    bru.setEnvVar("refreshToken", res.body.refresh_token);
    const memberships = res.body.user && res.body.user.memberships ? res.body.user.memberships : [];
    if (memberships.length > 0) {
      bru.setEnvVar("companyId", memberships[0].company.id);
    }
  }
}

tests {
  test("login succeeds", function() {
    expect(res.status).to.equal(200);
  });
}
