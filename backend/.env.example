DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=

# Production docker publish settings.
UETDS_BACKEND_HOST=0.0.0.0
UETDS_BACKEND_PORT=8080

# Local development falls back to sqlite when DB_ENGINE is not changed.
# PostgreSQL example:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=uetds
# DB_USER=uetds
# DB_PASSWORD=uetds
# DB_HOST=127.0.0.1
# DB_PORT=5432
POSTGRES_DB=uetds
POSTGRES_USER=uetds
POSTGRES_PASSWORD=change-me

JWT_ACCESS_HOURS=12
JWT_REFRESH_DAYS=7

UETDS_ENV=test
UETDS_ALLOW_LIVE=false
UETDS_TEST_URL=https://servis.turkiye.gov.tr/services/g2g/kdgm/test/uetdsarizi
UETDS_LIVE_URL=https://servis.turkiye.gov.tr/services/g2g/kdgm/uetdsarizi

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Required for mobile Foto/OCR passenger import.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=45
