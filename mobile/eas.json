{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://165.232.64.193:8080/api/v1",
        "EXPO_PUBLIC_BACKEND_LABEL": "server-test",
        "EXPO_PUBLIC_BACKEND_SHORT_LABEL": "SERVER"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://165.232.64.193:8080/api/v1",
        "EXPO_PUBLIC_BACKEND_LABEL": "server-test",
        "EXPO_PUBLIC_BACKEND_SHORT_LABEL": "SERVER"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "http://165.232.64.193:8080/api/v1",
        "EXPO_PUBLIC_BACKEND_LABEL": "server-test",
        "EXPO_PUBLIC_BACKEND_SHORT_LABEL": "SERVER"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
